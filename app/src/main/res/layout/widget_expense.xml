<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <!-- Header row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#8B949E"
            android:textSize="11sp"
            android:text="Today"/>

        <ImageButton
            android:id="@+id/widget_refresh_btn"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_popup_sync"
            android:background="@android:color/transparent"
            android:tint="#8B949E"/>
    </LinearLayout>

    <!-- Today amount -->
    <TextView
        android:id="@+id/widget_today_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#E6EDF3"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginTop="4dp"
        android:text="₹0.00"/>

    <TextView
        android:id="@+id/widget_today_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#8B949E"
        android:textSize="11sp"
        android:text="Today • 0 transactions"/>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#30363D"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"/>

    <!-- Monthly budget -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_budget_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#8B949E"
            android:textSize="11sp"
            android:text="₹0 / ₹10000"/>

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#00C896"
            android:textSize="11sp"
            android:text="✅ Good"/>
    </LinearLayout>

    <!-- Progress bar -->
    <ProgressBar
        android:id="@+id/widget_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="4dp"
        android:progressTint="#00C896"
        android:progressBackgroundTint="#30363D"
        android:max="100"
        android:progress="0"/>

    <!-- Month total -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#8B949E"
            android:textSize="11sp"
            android:text="This month"/>

        <TextView
            android:id="@+id/widget_month_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#B57AFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:text="₹0"/>
    </LinearLayout>

    <!-- Quick add button -->
    <Button
        android:id="@+id/widget_add_btn"
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="8dp"
        android:text="+ Add Expense"
        android:textSize="12sp"
        android:textColor="#000000"
        android:backgroundTint="#00C896"
        android:textStyle="bold"/>

</LinearLayout>