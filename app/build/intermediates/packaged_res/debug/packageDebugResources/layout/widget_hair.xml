<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/hair_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="💊 Hair Treatment"
        android:textColor="#8B949E"
        android:textSize="11sp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">

        <TextView
            android:id="@+id/hair_done"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#E6EDF3"
            android:textSize="26sp"
            android:textStyle="bold"
            android:text="0/13"/>

        <TextView
            android:id="@+id/hair_pct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#00C896"
            android:textSize="20sp"
            android:textStyle="bold"
            android:text="0%"/>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/hair_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="6dp"
        android:progressTint="#00C896"
        android:progressBackgroundTint="#30363D"
        android:max="100"
        android:progress="0"/>

    <TextView
        android:id="@+id/hair_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#8B949E"
        android:textSize="12sp"
        android:layout_marginTop="6dp"
        android:text="💊 Medicines due"/>

    <Button
        android:layout_width="match_parent"
        android:layout_height="32dp"
        android:layout_marginTop="8dp"
        android:text="Open Hair Tracker"
        android:textSize="11sp"
        android:textColor="#000000"
        android:backgroundTint="#00C896"
        android:id="@+id/hair_open_btn"/>

</LinearLayout>