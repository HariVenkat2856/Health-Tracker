<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/water_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="12dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="💧 Water Today"
        android:textColor="#8B949E"
        android:textSize="11sp"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/water_total"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#00A3FF"
            android:textSize="28sp"
            android:textStyle="bold"
            android:text="0ml"/>

        <TextView
            android:id="@+id/water_target"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#8B949E"
            android:textSize="13sp"
            android:layout_marginBottom="4dp"
            android:layout_marginStart="4dp"
            android:text="/ 3000ml"/>
    </LinearLayout>

    <ProgressBar
        android:id="@+id/water_progress"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="6dp"
        android:progressTint="#00A3FF"
        android:progressBackgroundTint="#30363D"
        android:max="100"
        android:progress="0"/>

    <TextView
        android:id="@+id/water_remaining"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#8B949E"
        android:textSize="11sp"
        android:layout_marginTop="4dp"
        android:text="3000ml more to go"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:weightSum="2">

        <Button
            android:id="@+id/water_add_250"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="+250ml"
            android:textSize="11sp"
            android:textColor="#FFFFFF"
            android:backgroundTint="#1C2330"/>

        <Button
            android:id="@+id/water_add_500"
            android:layout_width="0dp"
            android:layout_height="32dp"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:text="+500ml"
            android:textSize="11sp"
            android:textColor="#000000"
            android:backgroundTint="#00A3FF"/>
    </LinearLayout>

</LinearLayout>