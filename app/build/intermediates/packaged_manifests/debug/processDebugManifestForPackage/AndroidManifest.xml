    <permission
        android:name="com.venkat.healthapp.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.venkat.healthapp.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <application
        android:allowBackup="true"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:icon="@mipmap/drugs"
        android:label="Health Tracker"
        android:roundIcon="@mipmap/drugs"
        android:supportsRtl="true"
        android:testOnly="true"
        android:theme="@style/Theme.HealthApp"
        android:usesCleartextTraffic="true" >
        <activity
            android:name="com.venkat.healthapp.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.HealthApp.Starting" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Hair Alarm full-screen activity -->
        <activity
            android:name="com.venkat.healthapp.hair.alarm.AlarmActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:showOnLockScreen="true"
            android:taskAffinity=""
            android:theme="@style/Theme.HealthApp"
            android:turnScreenOn="true" />

        <!-- Hair medicine alarm receivers -->
        <receiver
            android:name="com.venkat.healthapp.hair.alarm.AlarmReceiver"
            android:exported="false" />
        <receiver
            android:name="com.venkat.healthapp.hair.alarm.AlarmDismissReceiver"
            android:exported="false" />
        <receiver
            android:name="com.venkat.healthapp.hair.alarm.BootReceiver"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- Water reminder receivers -->
        <receiver
            android:name="com.venkat.healthapp.water.ui.WaterReminderReceiver"
            android:exported="false" />
        <receiver
            android:name="com.venkat.healthapp.water.ui.WaterAutoReduceReceiver"
            android:exported="false" />
        <receiver
            android:name="com.venkat.healthapp.water.ui.WaterBootReceiver"
            android:exported="true" >
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- Amount -->

        <receiver
            android:name="com.venkat.healthapp.expense.ui.ExpenseNoteReminderReceiver"
            android:exported="false" />
        <receiver
            android:name="com.venkat.healthapp.expense.insights.InsightNotificationReceiver"
            android:exported="false" />

        <!-- FileProvider for camera photos -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="com.venkat.healthapp.provider"
            android:exported="false"
            android:grantUriPermissions="true" >
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <service
            android:name="com.google.firebase.components.ComponentDiscoveryService"
            android:directBootAware="true"
            android:exported="false" >
            <meta-data
                android:name="com.google.firebase.components:com.google.firebase.auth.ktx.FirebaseAuthLegacyRegistrar"
                android:value="com.google.firebase.components.ComponentRegistrar" />
            <meta-data
                android:name="com.google.firebase.components:com.google.firebase.auth.FirebaseAuthRegistrar"
                android:value="com.google.firebase.components.ComponentRegistrar" />
            <meta-data
                android:name="com.google.firebase.components:com.google.firebase.storage.ktx.FirebaseStorageLegacyRegistrar"
                android:value="com.google.firebase.components.ComponentRegistrar" />
            <meta-data
                android:name="com.google.firebase.components:com.google.firebase.storage.FirebaseStorageKtxRegistrar"
                android:value="com.google.firebase.components.ComponentRegistrar" />
            <meta-data
                android:name="com.google.firebase.components:com.google.firebase.storage.StorageRegistrar"
                android:value="com.google.firebase.components.ComponentRegistrar" />
            <meta-data
                android:name="com.google.firebase.components:com.google.firebase.firestore.ktx.FirebaseFirestoreLegacyRegistrar"
                android:value="com.google.firebase.components.ComponentRegistrar" />
            <meta-data
                android:name="com.google.firebase.components:com.google.firebase.firestore.FirebaseFirestoreKtxRegistrar"
                android:value="com.google.firebase.components.ComponentRegistrar" />
            <meta-data
                android:name="com.google.firebase.components:com.google.firebase.firestore.FirestoreRegistrar"
                android:value="com.google.firebase.components.ComponentRegistrar" />
            <meta-data
                android:name="com.google.firebase.components:com.google.firebase.appcheck.FirebaseAppCheckKtxRegistrar"
                android:value="com.google.firebase.components.ComponentRegistrar" />
